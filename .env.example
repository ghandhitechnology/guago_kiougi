# Copy to .env for local settings. Unset values take the defaults noted here, which are safe for
# a deployed server; local development opts in with NODE_ENV below.

# Local development only: drops the Secure cookie flag and allows the built-in SERVER_SECRET,
# and only while CLIENT_ORIGIN is a localhost origin. Leave it unset on a deployed server.
# NODE_ENV=development

# Game server HTTP and WebSocket port (default 2567)
# PORT=2567

# The origin the browser loads the client from; CORS and the API's Origin check allow only this
# CLIENT_ORIGIN=http://localhost:5173

# Required on any deployed server: 32+ random bytes, e.g. `openssl rand -base64 32`.
# Keys the stored IP hashes and the device cookies, and is the bearer token `pnpm live` sends.
# SERVER_SECRET=

# 1 behind a reverse proxy (Caddy) that sets X-Forwarded-For; never on a directly exposed server
# TRUST_PROXY=0

# New accounts per IP per day (PLAN §12 default 3); raise for a dormitory behind one address
# SIGNUPS_PER_IP_PER_DAY=3

# Players per channel of a map (PLAN §10 default 60, at most 100); load tests raise it to fill one room
# MAP_CHANNEL_SEATS=60

# Server clock rate on a fresh database: 1 is live; 1456 plays a 13-week Page in 90 minutes.
# Change it later with `pnpm live rate <n>` (PLAN §25 M4)
# LIVE_CLOCK_RATE=1

# Test servers only: 1 lets `pnpm live` move the clock, free bosses, restart the Page and inject
# combat and navigation events. Without it the admin route only reads
# LIVE_TEST_EVENTS=0

# Local cluster from `pnpm db:start`
# DATABASE_URL=postgres://guago:guago@127.0.0.1:54329/guago_dev
# TEST_DATABASE_URL=postgres://guago:guago@127.0.0.1:54329/guago_test
# LOCAL_PG_PORT=54329

# Vite dev server port and the game server it proxies /api and /rooms to
# CLIENT_PORT=5173
# GAME_SERVER_URL=http://localhost:2567

# Room metrics as JSON, served on 127.0.0.1 only (default: PORT + 100)
# METRICS_PORT=2667

# Admin API and page (PLAN §22): their own listener, never the game port. ADMIN_HOST must be a
# loopback address or this machine's Tailscale address (100.64.0.0/10 or fd7a:115c:a1e0::/48);
# the server refuses to start on anything else. Default 127.0.0.1 and PORT + 200.
# ADMIN_HOST=127.0.0.1
# ADMIN_PORT=2767
# The origin the admin page is opened from; state-changing requests must carry it. Default
# http://ADMIN_HOST:ADMIN_PORT (the admin listener serves the built page itself). An https origin
# (for example `tailscale serve`) makes the admin cookie Secure. In development with the Vite
# page on its own port: ADMIN_ORIGIN=http://localhost:5208
# ADMIN_ORIGIN=
# 1 only when the admin page sits behind a proxy on this machine, e.g. `tailscale serve --https
# 443 http://127.0.0.1:2767`: every admin then connects from loopback, and limits and audit rows
# key on the user the proxy names (Tailscale-User-Login, else the last X-Forwarded-For hop).
# Never set it without such a proxy: those headers would be the client's own word.
# ADMIN_TRUST_PROXY=0
# Admins are made only on this machine: `pnpm admin create <login> <moderator|owner>`.

# Development and load tests only: lets a joining client name the map and monster count of the
# room it opens (`pnpm loadtest --map campus-field --monsters 150`). Never on a deployed server.
# ALLOW_MAP_OPTION=1

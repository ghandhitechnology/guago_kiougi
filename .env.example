# Copy to .env for local overrides. Every value here is the default the server uses without it.

# development or test turn off the Secure cookie flag for plain-http localhost; anything else keeps it
NODE_ENV=development

# Game server HTTP and WebSocket port
PORT=2567

# The origin the browser loads the client from; CORS and the API's Origin check allow only this
CLIENT_ORIGIN=http://localhost:5173

# Local cluster from `pnpm db:start`
DATABASE_URL=postgres://guago:guago@127.0.0.1:54329/guago_dev
TEST_DATABASE_URL=postgres://guago:guago@127.0.0.1:54329/guago_test
LOCAL_PG_PORT=54329

# Key for hashing client IPs before they are stored. Required in production; use 32+ random bytes
IP_HASH_SECRET=

# 1 behind a reverse proxy (Caddy) that sets X-Forwarded-For; never on a directly exposed server
TRUST_PROXY=0

# Vite dev server port and the game server it proxies /api, /matchmake and room sockets to
CLIENT_PORT=5173
GAME_SERVER_URL=http://localhost:2567

{
  "name": "guago-kiougi",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.29.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm --filter \"./apps/*\" --if-present build",
    "typecheck": "pnpm -r --parallel typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "art:build": "pnpm --filter @guago/art build",
    "art:sheet": "pnpm --filter @guago/art sheet",
    "audio:lab": "pnpm --filter @guago/audio lab",
    "audio:render": "pnpm --filter @guago/audio render",
    "audio:score": "pnpm --filter @guago/audio score",
    "test:db": "vitest run --config vitest.db.config.ts",
    "db:start": "node apps/server/src/db/local.ts start",
    "db:stop": "node apps/server/src/db/local.ts stop",
    "db:reset": "node apps/server/src/db/local.ts reset",
    "db:migrate": "node --env-file-if-exists=.env apps/server/src/db/migrate.ts",
    "db:generate": "pnpm --filter @guago/server exec drizzle-kit generate",
    "economy": "node --env-file-if-exists=.env apps/server/src/economy/cli.ts",
    "admin": "node --env-file-if-exists=.env apps/server/src/admin/cli.ts",
    "balance": "pnpm --filter @guago/balance-sim balance",
    "loadtest": "pnpm --filter @guago/loadtest start",
    "netsim": "pnpm --filter @guago/loadtest netsim",
    "social:run": "pnpm --filter @guago/social-run start",
    "trade:run": "pnpm --filter @guago/trade-run start",
    "moderation:run": "pnpm --filter @guago/moderation-run start",
    "live": "node --env-file-if-exists=.env apps/server/src/live/cli.ts",
    "live:run": "pnpm --filter @guago/loadtest page-run"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@playwright/test": "^1.65.1",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  }
}

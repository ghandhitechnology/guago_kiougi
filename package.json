{
  "name": "guago-kiougi",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.29.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm --filter \"./apps/*\" --if-present build",
    "typecheck": "pnpm -r --parallel typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "art:build": "pnpm --filter @guago/art build",
    "art:sheet": "pnpm --filter @guago/art sheet",
    "test:db": "vitest run --config vitest.db.config.ts",
    "db:start": "node apps/server/src/db/local.ts start",
    "db:stop": "node apps/server/src/db/local.ts stop",
    "db:reset": "node apps/server/src/db/local.ts reset",
    "db:migrate": "node --env-file-if-exists=.env apps/server/src/db/migrate.ts",
    "db:generate": "pnpm --filter @guago/server exec drizzle-kit generate"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@playwright/test": "^1.65.1",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  }
}
